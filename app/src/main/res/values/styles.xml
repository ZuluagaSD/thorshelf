<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#C45100</item>
        <item name="android:colorControlActivated">#C45100</item>
        <item name="android:colorControlHighlight">#30F58821</item>
        <item name="android:textColorPrimary">#2D2827</item>
        <item name="android:textColorSecondary">#6F6862</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#FAF8F2</item>
        <item name="android:statusBarColor">#FAF8F2</item>
        <item name="android:navigationBarColor">#FAF8F2</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
